# Copy this file to .env for local development. Never commit real secrets.

# One password is intentionally reused by the private tools in this project.
STORAGE_PASSWORD=choose-a-long-unique-password

# Optional separate passwords. If blank, these use STORAGE_PASSWORD.
# CHAT_ADMIN_PASSWORD=
# SANDBOX_PASSWORD=
# PLANNER_PASSWORD=
# CODE_COPY_PASTE_PASSWORD=
# FEEDBACK_ADMIN_PASSWORD=

# AI providers. Leave blank to keep the matching provider unavailable.
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# OLLAMA_SEARCH_API_KEY=

# Optional market-data providers for the private Stock Simulator.
# TWELVEDATA_API_KEY=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# SIMULATOR_SESSION_SECRET=

# Optional upload and chat data locations for local development.
# CHAT_DATA_DIR=
# STORAGE_DATA_DIR=
# CODE_COPY_PASTE_DATA_PATH=
