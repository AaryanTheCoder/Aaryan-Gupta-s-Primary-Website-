# Nova's chatbot runs locally, so it has no API charge.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_MODELS_PATH=.ollama-models

# Optional: only change this if the Ollama program is in a custom location.
# OLLAMA_BIN=/path/to/ollama

# Optional: a FREE Ollama account key activates live web search.
# Get one at https://ollama.com/settings/keys
OLLAMA_API_KEY=

PORT=3000
